"use client";

import { useState, useEffect } from "react";
import { useRouter, useParams } from "next/navigation";
import { supabase } from "@/lib/supabase/client";
import { CATEGORIES } from "@/lib/utils/constants";
import NavBar from "@/components/layout/NavBar";
import type { Skill, User } from "@/lib/types";

type SkillDetail = Skill & {
  profiles: Pick<User, "id" | "full_name" | "avatar_url" | "bio" | "location_name">;
};

export default function SkillDetailPage() {
  const router = useRouter();
  const params = useParams();
  const [skill, setSkill] = useState<SkillDetail | null>(null);
  const [loading, setLoading] = useState(true);
  const [mySkills, setMySkills] = useState<Skill[]>([]);
  const [showSwapForm, setShowSwapForm] = useState(false);
  const [selectedMySkill, setSelectedMySkill] = useState("");
  const [swapMessage, setSwapMessage] = useState("");
  const [sending, setSending] = useState(false);
  const [error, setError] = useState("");
  const [success, setSuccess] = useState("");

  useEffect(() => {
    const load = async () => {
      const { data: { user } } = await supabase.auth.getUser();
      if (!user) {
        router.push("/auth");
        return;
      }

      // Fetch the skill detail
      const { data: skillData } = await supabase
        .from("skills")
        .select(`
          *,
          profiles!inner (
            id,
            full_name,
            avatar_url,
            bio,
            location_name
          )
        `)
        .eq("id", params.id)
        .single();

      if (skillData) {
        setSkill(skillData as any);
      }

      // Fetch user's skills (to offer in swap)
      const { data: mySkillsData } = await supabase
        .from("skills")
        .select("*")
        .eq("user_id", user.id);

      if (mySkillsData) setMySkills(mySkillsData);

      setLoading(false);
    };

    load();
  }, [params.id, router]);

  const handleRequestSwap = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!skill) return;
    setSending(true);
    setError("");
    setSuccess("");

    try {
      const { data: { user } } = await supabase.auth.getUser();
      if (!user) throw new Error("Not logged in");

      // Insert request into swap_requests table
      const { error: swapError } = await supabase.from("swap_requests").insert({
        requester_id: user.id,
        receiver_id: skill.user_id,
        requester_skill_id: selectedMySkill,
        receiver_skill_id: skill.id,
        message: swapMessage || null,
      });

      if (swapError) throw swapError;

      setSuccess("Swap request sent! They'll get a notification.");
      setShowSwapForm(false);
      setSwapMessage("");
    } catch (err: any) {
      setError(err.message || "Failed to send request");
    } finally {
      setSending(false);
    }
  };

  if (loading) {
    return (
      <div className="min-h-screen flex items-center justify-center">
        <div className="spinner" />
      </div>
    );
  }

  if (!skill) {
    return (
      <div className="min-h-screen flex items-center justify-center">
        <p className="text-muted">Skill not found</p>
      </div>
    );
  }

  const category = CATEGORIES.find((c) => c.id === skill.category_id);
  const isMySkill = skill.user_id === mySkills[0]?.user_id; // Check if it's the current user's own listing

  return (
    <div className="min-h-screen bg-warm-white">
      {/* Header */}
      <header className="bg-white border-b border-light-gray">
        <div className="max-w-lg mx-auto px-4 py-4">
          <button onClick={() => router.back()} className="text-sm font-medium text-forest hover:underline mb-2 block">
            ← Back
          </button>
        </div>
      </header>

      <main className="max-w-lg mx-auto px-4 pb-24 pt-4">
        <div className="bg-white rounded-xl p-6 border border-light-gray">
          {/* Category + Type */}
          <div className="flex items-center justify-between mb-3">
            <span className="text-sm text-muted">
              {category?.icon} {category?.name || "Other"}
            </span>
            <span className={skill.skill_type === "offer" ? "badge-offer" : "badge-want"}>
              {skill.skill_type === "offer" ? "Offering" : "Looking for"}
            </span>
          </div>

          {/* Title */}
          <h1 className="text-xl font-bold mb-2">{skill.title}</h1>

          {/* Description */}
          {skill.description && (
            <p className="text-sm text-muted mb-4">{skill.description}</p>
          )}

          {/* User Info */}
          <div className="border-t border-light-gray pt-4 mt-4">
            <p className="text-sm font-medium mb-1">Posted by</p>
            <p className="text-base font-semibold">{skill.profiles?.full_name || "Unknown"}</p>
            {skill.profiles?.location_name && (
              <p className="text-sm text-muted">📍 {skill.profiles.location_name}</p>
            )}
            {skill.profiles?.bio && (
              <p className="text-sm text-muted mt-2">{skill.profiles.bio}</p>
            )}
          </div>
        </div>

        {/* Request Swap Button / Form */}
        {!isMySkill && (
          <div className="mt-6">
            {!showSwapForm ? (
              <button
                onClick={() => setShowSwapForm(true)}
                className="btn-primary w-full text-center block"
              >
                Request Swap
              </button>
            ) : (
              <form onSubmit={handleRequestSwap} className="bg-white rounded-xl p-4 border border-light-gray space-y-4">
                <h3 className="font-semibold">Request a Swap</h3>

                {/* Pick your skill to offer */}
                <div>
                  <label className="block text-sm font-medium mb-1 text-gray-700">
                    Your skill to offer:
                  </label>
                  {mySkills.filter(s => s.skill_type === "offer").length === 0 ? (
                    <p className="text-sm text-red-600">
                      You need to add a skill you offer first.{" "}
                      <button type="button" onClick={() => router.push("/skills")} className="underline text-forest font-medium">Add one</button>
                    </p>
                  ) : (
                    <select
                      value={selectedMySkill}
                      onChange={(e) => setSelectedMySkill(e.target.value)}
                      required
                      className="input-field"
                    >
                      <option value="">Select a skill...</option>
                      {mySkills.filter(s => s.skill_type === "offer").map((s) => (
                        <option key={s.id} value={s.id}>{s.title}</option>
                      ))}
                    </select>
                  )}
                </div>

                {/* Message */}
                <div>
                  <label className="block text-sm font-medium mb-1 text-gray-700">
                    Message (optional)
                  </label>
                  <textarea
                    value={swapMessage}
                    onChange={(e) => setSwapMessage(e.target.value)}
                    rows={3}
                    className="input-field resize-none"
                    placeholder="Hi! I'd love to swap skills..."
                  />
                </div>

                {error && <p className="text-sm text-red-600">{error}</p>}
                {success && <p className="text-sm text-green-600">{success}</p>}

                <div className="flex gap-2">
                  <button
                    type="button"
                    onClick={() => { setShowSwapForm(false); setError(""); setSuccess(""); }}
                    className="flex-1 py-2 rounded-lg border border-light-gray text-sm text-muted"
                  >
                    Cancel
                  </button>
                  <button
                    type="submit"
                    disabled={sending || !selectedMySkill}
                    className="btn-primary flex-1 text-sm"
                  >
                    {sending ? "Sending..." : "Send Request"}
                  </button>
                </div>
              </form>
            )}
          </div>
        )}

        {isMySkill && (
          <p className="text-center text-sm text-muted mt-6">
            This is your own skill listing.
          </p>
        )}
      </main>

      <NavBar />
    </div>
  );
}